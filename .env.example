# Tushare token（必填）
TUSHARE_TOKEN=your_tushare_token_here

# 项目根目录
FUNDFACTORY_PROJECT_ROOT=

# 数据库路径（默认）
FUNDFACTORY_DB_PATH=data/factorfactory_open.db

# 导出输出目录
FUNDFACTORY_OUTPUT_DIR=output

# 数据源
FUNDFACTORY_PROVIDER=tushare

# 同步起始日期
FUNDFACTORY_SYNC_START=20200101

# 干跑模式（不实际写入数据）
DRY_RUN=true

# 操作前确认
REQUIRE_CONFIRM=true

# 日志级别
LOG_LEVEL=INFO
