# FundFactory Open - Environment Configuration Template
#
# Copy this file to the PROJECT ROOT directory (parent of fundfactory_core/)
# and name it ".env", then fill in values.
#
# PROJECT_ROOT is determined by:
#   1. FUNDFACTORY_PROJECT_ROOT environment variable (if set)
#   2. Parent directory of fundfactory_core/ (default)
#
# Example: if fundfactory_core/ is at /path/to/FundFactory_Open/fundfactory_core/
# then PROJECT_ROOT = /path/to/FundFactory_Open/
# and FUNDFACTORY_DB_PATH=data/fundfactory_open.db resolves to
# /path/to/FundFactory_Open/data/fundfactory_open.db

# ============== Tushare ==============
# Your Tushare Pro API key. Get one at https://tushare.pro/
TUSHARE_TOKEN=your_tushare_token_here

# ============== Database ==============
# Path to the SQLite database (relative to PROJECT_ROOT or absolute)
# Default: data/fundfactory_open.db  =>  {PROJECT_ROOT}/data/fundfactory_open.db
FUNDFACTORY_DB_PATH=data/fundfactory_open.db

# ============== Directories ==============
# Output directory for backtest results and exports (relative to PROJECT_ROOT)
# Default: output  =>  {PROJECT_ROOT}/output
FUNDFACTORY_OUTPUT_DIR=output

# ============== Data Provider ==============
# Currently only "tushare" is supported
FUNDFACTORY_PROVIDER=tushare

# ============== Data Sync ==============
# Default sync start date (YYYYMMDD)
FUNDFACTORY_SYNC_START=20200101

# ============== Backtest Defaults ==============
# These can be overridden via CLI flags
FUNDFACTORY_BENCHMARK=000300.SH
FUNDFACTORY_FEE_RATE=0.0003
FUNDFACTORY_SLIPPAGE=0.0005
FUNDFACTORY_REBALANCE_FREQ=20
FUNDFACTORY_TOP_PCT=0.1
FUNDFACTORY_INITIAL_CASH=1000000

# ============== Safety ==============
# Dry run mode - always true for backtesting
DRY_RUN=true

# Require confirmation before real actions
REQUIRE_CONFIRM=true

# ============== Logging ==============
LOG_LEVEL=INFO
